# GEO Knowledge Hub Validation Suite - Environment Variables
# ==========================================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.
#
# These are read by `gkh validate` and by the suite itself. A flag on the
# command line wins over the environment, which wins over this file.
#
#   cp .env.example .env

# Required: Your personal API token from the GKH web UI
# Settings → Applications → Personal access tokens → New token
GKH_API_TOKEN=your_token_here

# Optional: Base URL of the GKH instance (default shown)
GKH_BASE_URL=https://your_instance_url

# Optional: Set to true to skip TLS verification (self-signed certs)
GKH_NO_VERIFY_TLS=true
