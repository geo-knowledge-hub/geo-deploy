# GEO Knowledge Hub Test Suite — Environment Variables
# =====================================================
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will never be committed.
#
#   cp .env.example .env

# Required: Your personal API token from the GKH web UI
# Settings → Applications → Personal access tokens → New token
GEO_API_TOKEN=your_token_here

# Optional: Base URL of the GKH instance (default shown)
GEO_BASE_URL=https://your_instance_url

# Optional: Set to true to skip TLS verification (self-signed certs)
GEO_NO_VERIFY_TLS=true
