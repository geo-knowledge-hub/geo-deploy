#!/usr/bin/env bash
#
# Creates the Secrets that values.yaml references.
#
# Run this BEFORE `helm install`. Passwords are generated here and never written
# to gkh-deploy.yaml or values.yaml, so nothing in the bundle has to be kept out
# of version control.
#
# Re-running is safe: each Secret is created only if it is missing.

set -euo pipefail

NAMESPACE="{{ settings.namespace }}"

kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -

password() {
  openssl rand -base64 24 | tr -d '/+=' | head -c 32
}

create_secret() {
  local name="$1"
  shift

  if kubectl get secret "$name" -n "$NAMESPACE" >/dev/null 2>&1; then
    echo "secret/$name already exists, leaving it alone"
    return
  fi

  kubectl create secret generic "$name" -n "$NAMESPACE" "$@"
}

# Both keys go in the same Secret: the chart reads the Invenio user'sInvenio user's s's password from
# `password`, and its PostgreSQL subchart reads the `postgres` superuser's from
# `postgres-password`. A Secret holding only the first leaves the database pod in
# CreateContainerConfigError.
create_secret "{{ settings.secrets.postgresql }}" \
  --from-literal=password="$(password)" \
  --from-literal=postgres-password="$(password)"

create_secret "{{ settings.secrets.rabbitmq }}" \
  --from-literal=rabbitmq-password="$(password)"

{% if settings.datacite.enabled %}
# DataCite credentials come from your DataCite account. There is nothing to
# generate. Replace the placeholders before running this script.
create_secret "{{ settings.datacite.secret_name }}" \
  --from-literal=DATACITE_USERNAME="REPLACE_ME" \
  --from-literal=DATACITE_PASSWORD="REPLACE_ME"
{%- endif %}

echo
echo "Done. Verify with: kubectl get secrets -n $NAMESPACE"
