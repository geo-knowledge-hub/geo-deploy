# Helm values for {{ chart_name }} {{ chart_version }} (InvenioRDM {{ app_version }}).
#
# Generated by gkh deploy generate. Edit gkh-deploy.yaml and regenerate rather
# than editing this file, so the deployment stays reproducible.
#
# No credentials appear here. Passwords are read from Secrets created by
# secrets.sh, so they never reach a pod's environment as literal values.

image:
  registry: docker.io
  repository: {{ settings.image.repository }}
  tag: "{{ settings.image.tag }}"

invenio:
  hostname: "{{ settings.hostname }}"

  # The post-install sequence is run by bootstrap.sh, which loads the
  # vocabularies before anything that needs them. The chart's init job does not.
  init: false
  demo_data: false

  extraConfig:
{%- for key, value in extra_config.items() %}
    {{ key }}: {{ value | yaml }}
{%- endfor %}

  datacite:
    enabled: {{ settings.datacite.enabled | lower }}
{%- if settings.datacite.enabled %}
    # Empty, so the chart reads the credentials from the Secret named below
    # rather than silently skipping its creation.
    username: ""
    password: ""
    existingSecret: "{{ settings.datacite.secret_name }}"
    secretKeys:
      usernameKey: "DATACITE_USERNAME"
      passwordKey: "DATACITE_PASSWORD"
    prefix: "{{ settings.datacite.prefix }}"
    testMode: "{{ 'True' if settings.datacite.test_mode else 'False' }}"
{%- endif %}

ingress:
  enabled: {{ settings.ingress.enabled | lower }}
  class: "{{ settings.ingress.class }}"
{%- if settings.ingress.tls_secret %}
  tlsSecretNameOverride: "{{ settings.ingress.tls_secret }}"
{%- endif %}

web:
  replicas: {{ settings.scaling.web_replicas }}
  uwsgi:
    processes: {{ settings.scaling.uwsgi_processes }}
    threads: {{ settings.scaling.uwsgi_threads }}

worker:
  replicas: {{ settings.scaling.worker_replicas }}
  concurrency: {{ settings.scaling.worker_concurrency }}

persistence:
  enabled: {{ settings.storage.enabled | lower }}
  size: {{ settings.storage.size }}
{%- if settings.storage.class %}
  storage_class: "{{ settings.storage.class }}"
{%- endif %}

postgresql:
  enabled: true
  auth:
    username: invenio
    database: invenio
    existingSecret: "{{ settings.secrets.postgresql }}"
    secretKeys:
      userPasswordKey: password

redis:
  enabled: true
  architecture: standalone
  auth:
    enabled: false

rabbitmq:
  enabled: true
  auth:
    existingPasswordSecret: "{{ settings.secrets.rabbitmq }}"
    existingSecretPasswordKey: rabbitmq-password

opensearch:
  enabled: true

  # One node holding every role. heapSize is half the memory limit. The bundled
  # defaults put the data pool's heap at two thirds of its limit, which is
  # OOMKilled while the vocabularies are indexed.
  master:
    masterOnly: false
    replicaCount: 1
    heapSize: {{ settings.opensearch.heap }}
    resources:
      requests:
        cpu: "{{ settings.opensearch.cpu_request }}"
        memory: {{ settings.opensearch.memory_request }}
      limits:
        cpu: "{{ settings.opensearch.cpu_limit }}"
        memory: {{ settings.opensearch.memory_limit }}

  data:
    replicaCount: 0
  ingest:
    replicaCount: 0
  coordinating:
    replicaCount: 0

flower:
  enabled: {{ settings.flower.enabled | lower }}
{%- if extra_values %}

{{ extra_values }}
{%- endif %}
